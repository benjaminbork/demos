{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Azure": "Warning"
    },
    "Console": { "FormatterName": "simple", "FormatterOptions": { "SingleLine": true, "TimestampFormat": "HH:mm:ss " } }
  },
  "App": { "UserId": "me", "AiMode": "Azure" },
  "Cosmos": { "Endpoint": "", "Database": "audioblog", "ArticlesContainer": "articles", "LeasesContainer": "leases" },
  "Storage": { "BlobEndpoint": "", "AudioContainer": "audio" },
  "AzureOpenAI": { "Endpoint": "", "Deployment": "gpt-5.4-mini", "ReasoningEffort": "low" },
  "Speech": { "Region": "", "ResourceId": "", "OutputFormat": "audio-24khz-48kbitrate-mono-mp3", "BitrateKbps": 48 },
  "Pipeline": { "MaxAttempts": 3, "RetryDelaysSeconds": [ 20, 60 ], "LeaseSeconds": 120, "MaxConcurrency": 2, "SweepIntervalSeconds": 15 },
  "Worker": { "ChangeFeedPollSeconds": 5 },
  "Fetch": { "TimeoutSeconds": 30, "MaxBytes": 5242880 }
}
